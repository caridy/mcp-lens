{
  "name": "@mcp-lens/presets",
  "version": "0.1.2",
  "description": "Reference library of moment-shaped lens presets for MCP Lens. Compiled at build time from ../../presets/<domain>/*.md. Authored as markdown; consumed as typed TypeScript exports per domain.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generic": {
      "types": "./dist/generic/index.d.ts",
      "import": "./dist/generic/index.js"
    },
    "./incidents": {
      "types": "./dist/incidents/index.d.ts",
      "import": "./dist/incidents/index.js"
    },
    "./orders": {
      "types": "./dist/orders/index.d.ts",
      "import": "./dist/orders/index.js"
    },
    "./shoes": {
      "types": "./dist/shoes/index.d.ts",
      "import": "./dist/shoes/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:compile": "node scripts/compile-presets.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build": "pnpm run build:compile && pnpm run build:ts",
    "typecheck": "pnpm run build:compile && tsc --noEmit -p tsconfig.json",
    "test": "echo 'no tests'",
    "clean": "rm -rf dist src tsconfig.tsbuildinfo && echo 'note: src/ is fully generated by build:compile.'"
  },
  "keywords": [
    "mcp",
    "mcp-lens",
    "lens-presets"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mcp-lens/sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@mcp-lens/sdk": "^0.1.2",
    "gray-matter": "^4.0.3",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1"
  }
}
