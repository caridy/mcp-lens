{
  "name": "recipes-mcp",
  "version": "0.1.0",
  "description": "Demo MCP server — a recipe catalog. Deliberately Lens-unaware: no mcp-lens dependency, no widgets, no presets. Pair with mcp-lens-server to see how lenses can layer on top of an existing server without any changes to it.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "bin": {
    "recipes-mcp": "./dist/stdio.js",
    "recipes-mcp-http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo 'no tests'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "pnpm run build && node dist/stdio.js",
    "start:http": "pnpm run build && node dist/http.js",
    "serve:http": "node dist/http.js",
    "dev:http": "tsx --watch src/http.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
